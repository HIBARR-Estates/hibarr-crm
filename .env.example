APP_NAME=Worksuite
APP_KEY=base64:wID/CO/WkfE3yoWpQOoy15de8FtOpvC3dM/z5FuHiEU=

# Do not change APP_ENV to anything else. It will affect emailing from admin panel
# and other configuration from databse and system may crash
APP_ENV=codecanyon
APP_DEBUG=false

APP_URL=http://localhost

#For redirect to https
REDIRECT_HTTPS=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# File Upload Service Configuration
# Used for external file uploads to reduce server load
VITE_FILE_UPLOAD_BASE_URL=https://staging-api.hibarr.org
VITE_FILE_UPLOAD_API_KEY="api key here"
# Backend (PHP) file upload service - same external API, used by CustomFieldsTrait
FILE_UPLOAD_BASE_URL=https://staging-api.hibarr.org/v1
FILE_UPLOAD_API_KEY="api key here"

# AI Description Generator (Gemini)
# Set this to enable AI-powered property description generation
VITE_GEMINI_API_KEY=

# AI Report Summary (Hibarr AI Gateway)
AI_BASE_URL=https://staging-api.hibarr.org/v1
AI_TIMEOUT=45
AI_PROVIDER=openai
AI_MODEL=gpt-4o
AI_API_KEY=

# OpenTelemetry - Log streaming to Signoz
# Set LOG_CHANNEL=stack to enable dual-write (file + OTel)
LOG_CHANNEL=stack
OTEL_LOGS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=https://otelcollector.hibarr.org
OTEL_SERVICE_NAME=hibarr-crm
