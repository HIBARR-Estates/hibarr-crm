# Copy to .env.reverb.<environment> (never commit it) and use it with docker-compose.reverb.yml.
# One file per environment; the REVERB_APP_* secrets themselves live in Infisical, not here.

# Same image tag as this environment's app.
REVERB_IMAGE=ghcr.io/your-org/hibarr-crm:CHANGE-ME

# Infisical machine identity for THIS environment (staging -> staging, production -> prod).
INFISICAL_TOKEN=
INFISICAL_API_URL=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=staging

# Where the container listens on the host. Loopback unless the proxy/app is on another machine.
REVERB_BIND=127.0.0.1
REVERB_PORT_LOCAL=8080

# In Infisical for this environment (the app and queue worker need the same values):
#   REVERB_APP_ID / REVERB_APP_KEY / REVERB_APP_SECRET   fresh per environment (openssl rand -hex 16 / 32)
#   REVERB_HOST / REVERB_PORT / REVERB_SCHEME            the public ws.<domain> browsers connect to, 443, https
#   REVERB_PUBLISH_HOST / _PORT / _SCHEME                where the APP reaches this container, e.g. 127.0.0.1 / 8080 / http
#   REVERB_ALLOWED_ORIGINS                               the CRM's hostname(s), not the ws. host
#   NOTIFICATIONS_REALTIME_ENABLED=true
#   APP_KEY=base64:...                                   present, so the container starts without waiting for a key file
