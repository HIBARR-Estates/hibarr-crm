{
    // PHP settings
    "php.validate.enable": true,
    "php.validate.executablePath": "C:/tools/php83/php.exe", 
    "php.suggest.basic": true,
  
    // Intelephense tweaks (if installed)
    "intelephense.files.exclude": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/storage/**",
      "**/cache/**"
    ],
    "intelephense.indexing.enabled": true,
    "intelephense.environment.memoryLimit": "512M",
    "intelephense.telemetry.enabled": false,
  
    // Editor performance
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.wordBasedSuggestions": false,
  
    // File watcher optimization
    "files.watcherExclude": {
      "**/node_modules/*": true,
      "**/vendor/*": true,
      "**/.git/*": true
    },
  
    // Terminal & Code Runner
    "code-runner.executorMap": {
      "php": "php"
    },
    "code-runner.runInTerminal": true,
  
    // Snippets (optional)
    "php.snippets.enabled": true
  }