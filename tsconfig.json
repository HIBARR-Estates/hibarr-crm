{
    "compilerOptions": {
        // "types": ["vite/client"],
        "types": ["node"],
        "target": "ES2020",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "module": "esnext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": false,
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"],
            "@/Components/*": ["resources/js/Components/*"],
            "@/Pages/*": ["resources/js/Pages/*"],
            "@/Types/*": ["resources/js/Types/*"],
            "@/Features/*": ["resources/js/Features/*"],
            "@/lib/*": ["resources/js/lib/*"],
            "@/Hooks/*": ["resources/js/Hooks/*"],
            "@tanstack/charts": ["node_modules/@tanstack/charts/dist/index.d.ts"],
            "@tanstack/charts/tooltip/portal": ["node_modules/@tanstack/charts/dist/tooltip-portal.d.ts"],
            "@tanstack/charts/react/tooltip": ["node_modules/@tanstack/charts/dist/react/tooltip.d.ts"],
            "@tanstack/charts/*": ["node_modules/@tanstack/charts/dist/*"],
            "@inertia-load-page": ["resources/js/inertia/loadPage.vite.ts"]
        },
        "checkJs": false,
        "skipDefaultLibCheck": true
    },
    "include": ["resources/js/**/*"],
    "exclude": ["node_modules"]
}
